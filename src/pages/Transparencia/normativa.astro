---
import Layout from "../../layouts/Layout.astro";
import NormativaPageClient from "../../components/normativa/NormativaPageClient";
---

<Layout title="Normativa | Municipalidad de San Vicente">
  <NormativaPageClient client:load />
</Layout>

<style is:global>
  .normativa-container {
    min-height: 100vh;
    background-color: var(--color-fondo-claro);
  }
  .normativa-container .content-wrapper {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .normativa-container .grid-gap {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Hero */
  .normativa-container .hero-normativa {
    background-color: var(--color-primario);
    color: white;
    padding: 3.5rem 0;
    text-align: center;
  }
  .normativa-container .hero-normativa .hero-icon {
    background: rgba(255, 255, 255, 0.18);
    width: 72px;
    height: 72px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
  }
  .normativa-container .hero-normativa h1 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 800;
    margin: 0 0 0.75rem;
    line-height: 1.15;
  }
  .normativa-container .hero-normativa p {
    font-size: 1.1rem;
    opacity: 0.92;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Tabs tipo */
  .normativa-container .type-tabs-section {
    background: #fff;
    border-bottom: 1px solid #e2e8f0;
    padding: 1.25rem 0 0;
  }
  .normativa-container .type-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .normativa-container .type-tab {
    background: transparent;
    color: #475569;
    -webkit-text-fill-color: #475569;
    border: none;
    padding: 0.85rem 1.5rem;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    border-bottom: 3px solid transparent;
    transition: color 0.2s, border-color 0.2s;
    margin-bottom: -1px;
  }
  .normativa-container .type-tab:hover {
    color: var(--color-primario);
    -webkit-text-fill-color: var(--color-primario);
  }
  .normativa-container .type-tab.active {
    color: var(--color-primario);
    -webkit-text-fill-color: var(--color-primario);
    border-bottom-color: var(--color-primario);
  }

  /* Filtros */
  .normativa-container .filters-bar {
    background: #fff;
    border-bottom: 1px solid #e2e8f0;
    padding: 1.25rem 0 1rem;
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .normativa-container .filters-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .normativa-container .search-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 240px;
    max-width: 360px;
  }
  .normativa-container .search-wrapper .search-icon {
    position: absolute;
    left: 1rem;
    color: var(--color-primario);
    pointer-events: none;
  }
  .normativa-container .search-input {
    padding: 0.6rem 1rem 0.6rem 2.5rem;
    border: 1px solid #e2e8f0;
    border-radius: 0.5rem;
    width: 100%;
    min-height: 40px;
    box-sizing: border-box;
    font-size: 0.95rem;
  }
  .normativa-container .search-input:focus {
    outline: none;
    border-color: var(--color-primario);
  }
  .normativa-container .selects-wrapper {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .normativa-container .filter-select {
    padding: 0.55rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid #e2e8f0;
    background: white;
    font-size: 0.9rem;
    color: #0f172a;
    min-height: 40px;
    cursor: pointer;
  }
  .normativa-container .filter-select:focus {
    outline: none;
    border-color: var(--color-primario);
  }
  .normativa-container .btn-ghost {
    background: none;
    border: none;
    color: var(--color-primario);
    -webkit-text-fill-color: var(--color-primario);
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.5rem 0.75rem;
  }
  .normativa-container .btn-ghost:hover {
    text-decoration: underline;
  }
  .normativa-container .results-count-row {
    margin-top: 0.75rem;
  }
  .normativa-container .results-count {
    font-size: 0.85rem;
    color: #64748b;
    margin: 0;
  }

  /* Listado */
  .normativa-container .list-section {
    padding: 2.5rem 0 4rem;
  }
  .normativa-container .normativa-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .normativa-container .normativa-card {
    background: white;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .normativa-container .normativa-card:hover {
    box-shadow: 0 8px 16px -6px rgba(0, 0, 0, 0.1);
  }
  .normativa-container .card-main {
    flex: 1;
    min-width: 0;
  }
  .normativa-container .card-meta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .normativa-container .card-number {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-weight: 700;
    color: var(--color-primario);
    font-size: 0.9rem;
  }
  .normativa-container .card-year {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    color: #64748b;
    font-size: 0.9rem;
  }
  .normativa-container .status-badge {
    padding: 0.2rem 0.65rem;
    border-radius: 99px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .normativa-container .status-vigente {
    background: #dcfce7;
    color: #15803d;
  }
  .normativa-container .status-modificada {
    background: #ffedd5;
    color: #c2410c;
  }
  .normativa-container .status-derogada {
    background: #fee2e2;
    color: #b91c1c;
  }
  .normativa-container .status-vetada {
    background: #f1f5f9;
    color: #475569;
  }
  .normativa-container .card-title {
    font-size: 1.15rem;
    line-height: 1.4;
    margin: 0.25rem 0 0.5rem;
    color: var(--color-texto);
  }
  .normativa-container .card-title-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }
  .normativa-container .card-title-link:hover {
    color: var(--color-primario);
  }
  .normativa-container .card-summary {
    color: #475569;
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0 0 0.85rem;
  }
  .normativa-container .card-info-row {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    font-size: 0.825rem;
    color: #64748b;
  }
  .normativa-container .card-info-item .label {
    color: #94a3b8;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    margin-right: 0.25rem;
  }
  .normativa-container .card-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }
  .normativa-container .tag-chip {
    background: #f1f5f9;
    color: #475569;
    font-size: 0.7rem;
    padding: 0.15rem 0.55rem;
    border-radius: 99px;
    font-weight: 500;
  }
  .normativa-container .card-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 170px;
    align-self: center;
  }
  .normativa-container .btn-primary-sm,
  .normativa-container .btn-outline-sm {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.55rem 0.85rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: 0.2s;
    border: 1px solid transparent;
    box-sizing: border-box;
    min-height: 38px;
  }
  .normativa-container .btn-primary-sm {
    background: var(--color-primario);
    color: white;
  }
  .normativa-container .btn-primary-sm:hover {
    background: var(--color-primario-hover);
  }
  .normativa-container .btn-outline-sm {
    border-color: #e2e8f0;
    background: white;
    color: #334155;
  }
  .normativa-container .btn-outline-sm:hover {
    border-color: var(--color-primario);
    color: var(--color-primario);
  }
  .normativa-container .file-size {
    font-size: 0.7rem;
    color: #94a3b8;
    margin-left: 0.25rem;
  }

  /* Vacío + paginación */
  .normativa-container .empty-state {
    text-align: center;
    padding: 3.5rem 2rem;
    background: white;
    border-radius: 12px;
    border: 1px dashed #e2e8f0;
  }
  .normativa-container .empty-state p {
    color: #64748b;
    margin-bottom: 0.5rem;
  }
  .normativa-container .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }
  .normativa-container .pagination .page-btn {
    padding: 0.5rem 1rem;
    border: 1px solid #e2e8f0;
    background: white;
    border-radius: 0.5rem;
    cursor: pointer;
    font-weight: 600;
    color: var(--color-primario);
    transition: all 0.2s;
  }
  .normativa-container .pagination .page-btn:hover:not(:disabled) {
    background: var(--color-primario);
    color: white;
    border-color: var(--color-primario);
  }
  .normativa-container .pagination .page-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .normativa-container .pagination .page-info {
    font-size: 0.9rem;
    color: #64748b;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .normativa-container .hero-normativa {
      padding: 2.25rem 0;
    }
    .normativa-container .filters-flex {
      flex-direction: column;
      align-items: stretch;
    }
    .normativa-container .search-wrapper {
      max-width: none;
    }
    .normativa-container .selects-wrapper {
      flex-wrap: wrap;
    }
    .normativa-container .filter-select {
      flex: 1;
      min-width: 140px;
    }
    .normativa-container .normativa-card {
      flex-direction: column;
    }
    .normativa-container .card-actions {
      flex-direction: row;
      min-width: 0;
      width: 100%;
    }
    .normativa-container .card-actions a {
      flex: 1;
    }
  }
</style>
