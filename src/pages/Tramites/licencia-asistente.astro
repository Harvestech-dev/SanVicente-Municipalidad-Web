---
import Layout from "../../layouts/Layout.astro";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import licenciaData from "../../data/licencia.json";

const chatbotHtml = readFileSync(
  resolve("./public/chatbot/licencia/index.html"),
  "utf8"
);

// Datos de contacto desde licencia.json (fuente única) — se inyectan al chatbot
// como window.SV_LICENCIA_DATOS. El chatbot usa estos valores y, si no existen,
// cae a sus constantes embebidas (vista standalone).
const svDatos = {
  whatsapp: licenciaData.whatsapp,
  localidades: (licenciaData.localidades_circuito?.localidades ?? []).map((l) => ({
    nombre: l.nombre,
    whatsapp: l.whatsapp,
    mail: l.mail,
  })),
};

// 1. Estilos: concatenar <style>...</style>, quitar body{}/html{} (rompen layout host)
const stylesRaw = [
  ...chatbotHtml.matchAll(/<style[^>]*>([\s\S]*?)<\/style>/gi),
]
  .map((m) => m[1])
  .join("\n");
const styles = stylesRaw
  .replace(/(^|[\s,;}])body\s*\{[^}]*\}/g, "$1")
  .replace(/(^|[\s,;}])html\s*\{[^}]*\}/g, "$1");

// 2. Body interno (sin <style>/<script>)
const bodyMatch = chatbotHtml.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
let bodyHtml = bodyMatch?.[1] ?? "";
bodyHtml = bodyHtml
  .replace(/<style[^>]*>[\s\S]*?<\/style>/gi, "")
  .replace(/<script[^>]*>[\s\S]*?<\/script>/gi, "");

// 3. Script: redirigir queries de DOM al shadow root del host
const scriptMatch = chatbotHtml.match(
  /<script(?![^>]*\bsrc=)[^>]*>([\s\S]*?)<\/script>/i
);
let scriptCode = scriptMatch?.[1] ?? "";
scriptCode = scriptCode
  .replace(/document\.getElementById\(/g, "root.getElementById(")
  .replace(/document\.querySelectorAll\(/g, "root.querySelectorAll(")
  .replace(/document\.querySelector\(/g, "root.querySelector(");
---

<Layout title="Asistente Licencia de Conducir — San Vicente">
  <main class="asistente-page">
    <div class="container page-toolbar">
      <a href="/Tramites/licencia" class="back-link">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
        Volver a Licencias
      </a>
    </div>

    <section class="asistente-section">
      <div class="container asistente-container">
        <h1 class="sr-only">Asistente de Licencia de Conducir</h1>
        <sv-asistente-licencia class="asistente-host"></sv-asistente-licencia>
      </div>
    </section>
  </main>

  <script is:inline define:vars={{ styles, bodyHtml, scriptCode, svDatos }}>
    class SvAsistenteLicencia extends HTMLElement {
      connectedCallback() {
        if (this.shadowRoot) return;
        const root = this.attachShadow({ mode: "open" });

        const styleEl = document.createElement("style");
        styleEl.textContent = styles;
        root.appendChild(styleEl);

        const tmp = document.createElement("div");
        tmp.innerHTML = bodyHtml;
        while (tmp.firstChild) root.appendChild(tmp.firstChild);

        // Inyecta los datos de contacto (licencia.json) antes de correr el chatbot
        window.SV_LICENCIA_DATOS = svDatos;

        // Ejecuta el script original en IIFE con `root` = shadow root del host
        const s = document.createElement("script");
        s.textContent =
          "(function(){var root=document.querySelector('sv-asistente-licencia').shadowRoot;" +
          scriptCode +
          "})();";
        document.head.appendChild(s);
      }
    }
    if (!customElements.get("sv-asistente-licencia")) {
      customElements.define("sv-asistente-licencia", SvAsistenteLicencia);
    }
  </script>
</Layout>

<style>
  .asistente-page {
    background-color: var(--color-fondo-claro);
    color: var(--color-texto);
    display: flex;
    flex-direction: column;
    height: calc(100dvh - 68px);
    min-height: 0;
    overflow: hidden;
  }
  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .page-toolbar {
    padding-top: 1.25rem;
    padding-bottom: 0.5rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-primario);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.45rem 0.75rem 0.45rem 0.6rem;
    border-radius: 8px;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .back-link svg {
    transition: transform 0.15s ease;
  }
  .back-link:hover,
  .back-link:focus-visible {
    background: var(--color-primario-suave, #fdf2e9);
    color: var(--color-primario-hover, #a05a0b);
  }
  .back-link:hover svg,
  .back-link:focus-visible svg {
    transform: translateX(-2px);
  }
  .back-link:focus-visible {
    outline: 2px solid var(--color-primario);
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .asistente-section {
    padding: 0.5rem 0 1rem;
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .asistente-container {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .asistente-host {
    display: block;
    box-sizing: border-box; /* el sitio no tiene reset global; sin esto width:100%+padding desborda */
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scroll-padding-bottom: 32px;
    scrollbar-gutter: stable both-edges;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
    max-width: 720px;
    width: 100%;
    margin: 0 auto;
    padding: 0 12px;
  }

  /* Mobile: el asistente ocupa TODO el viewport como un modal (cubre el header del sitio).
     Se oculta la toolbar "Volver" — su rol lo cumple la X de cerrar dentro del chat. */
  @media (max-width: 768px) {
    .page-toolbar {
      display: none;
    }
    .asistente-section {
      padding: 0;
    }
    .asistente-container {
      padding: 0;
    }
    .asistente-host {
      position: fixed;
      inset: 0;
      z-index: 1100; /* por encima del header sticky del sitio (z-index:1000) */
      max-width: none;
      width: 100%;
      margin: 0;
      border: none;
      border-radius: 0;
      box-shadow: none;
      padding: 0 8px;
    }
  }
</style>
