---
import Layout from "../../layouts/Layout.astro";
import LicenciaGuia from "../../components/licencia/LicenciaGuia.astro";
import LicenciaContactoPanel from "../../components/licencia/LicenciaContactoPanel.astro";
import data from "../../data/licencia.json";

const { txt_titulo: titulo, txt_descripcion: descripcion, whatsapp, centro } = data;

const emailFinal = centro.mail;
const telFinal = centro.telefono;
const waUrl = `https://wa.me/${whatsapp}?text=${encodeURIComponent("Hola, tengo una consulta sobre licencia de conducir.")}`;
---

<Layout title={`${titulo} — San Vicente`} description={descripcion}>
  <main class="licencias-page">
    <div class="licencia-top">
      <section class="hero-simple">
        <div class="container">
          <h1>{titulo}</h1>
          <p>{descripcion}</p>
        </div>
      </section>

      <div class="container asistente-float">
        <a href="/Tramites/licencia-asistente" class="asistente-feature">
          <div class="asistente-feature-body">
            <div class="asistente-feature-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                <path d="M8 10h.01"></path><path d="M12 10h.01"></path><path d="M16 10h.01"></path>
              </svg>
            </div>
            <div class="asistente-feature-text">
              <h2>Asistente de trámite</h2>
              <p>
                Respondé unas preguntas y te indicamos requisitos, costo estimado y cómo
                reservar turno según tu caso.
              </p>
            </div>
            <span class="asistente-feature-cta">
              Iniciar trámite
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
            </span>
          </div>
        </a>
      </div>
    </div>

    <section class="licencia-contacto">
      <div class="container">
        <LicenciaContactoPanel />
      </div>
    </section>

    <LicenciaGuia />

    <section class="cta-licencias">
      <div class="container">
        <h2>¿Necesitás ayuda con tu trámite?</h2>
        <p>Escribinos o comunicate por los canales oficiales del Centro de Licencias</p>
        <div class="cta-buttons">
          <a href={waUrl} class="btn-cta-white btn-wa" target="_blank" rel="noopener noreferrer">
            WhatsApp
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
          </a>
          <a href={`tel:${telFinal}`} class="btn-cta-outline">
            Llamar
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
          </a>
          <a href={`mailto:${emailFinal}`} class="btn-cta-outline">
            Email
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .licencias-page {
    background-color: var(--color-fondo-claro);
    color: var(--color-texto);
  }

  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .licencia-top {
    position: relative;
  }

  .hero-simple {
    background: var(--color-primario);
    color: white;
    padding: 3.5rem 0 5.5rem;
    text-align: center;
  }

  .hero-simple h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .hero-simple p {
    font-size: 1.1rem;
    opacity: 0.92;
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* Card flotante: ~50% sobre el hero */
  .asistente-float {
    position: relative;
    z-index: 5;
    margin-top: -4.25rem;
  }

  .asistente-feature {
    display: block;
    max-width: 100%;
    box-sizing: border-box;
    text-decoration: none;
    color: inherit;
    background: white;
    border: 2px solid var(--color-primario);
    border-radius: 16px;
    padding: 1.35rem 1.75rem;
    box-shadow:
      0 8px 28px rgba(15, 23, 42, 0.12),
      0 4px 16px rgba(194, 109, 14, 0.14);
    transition: box-shadow 0.15s, border-color 0.15s;
  }

  .asistente-feature:hover {
    border-color: var(--color-primario-hover, #a05a0b);
    box-shadow:
      0 10px 32px rgba(15, 23, 42, 0.14),
      0 6px 20px rgba(194, 109, 14, 0.2);
  }

  .asistente-feature-body {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
    width: 100%;
    min-width: 0;
  }

  .asistente-feature-icon {
    background: var(--color-primario-suave, #fdf2e9);
    color: var(--color-primario);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .asistente-feature-text {
    flex: 1;
    min-width: 0;
  }

  .asistente-feature h2 {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0 0 0.35rem;
    color: var(--color-texto);
  }

  .asistente-feature p {
    margin: 0;
    font-size: 0.95rem;
    color: #64748b;
    line-height: 1.5;
  }

  .asistente-feature-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: white;
    background: var(--color-primario);
    padding: 0.75rem 1.35rem;
    border-radius: 10px;
    flex-shrink: 0;
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(194, 109, 14, 0.35);
    transition: background 0.15s, box-shadow 0.15s;
  }

  .asistente-feature:hover .asistente-feature-cta {
    background: var(--color-primario-hover, #a05a0b);
    box-shadow: 0 4px 12px rgba(194, 109, 14, 0.4);
  }

  .licencia-contacto {
    padding: 2rem 0 2.5rem;
  }

  /* CTA final */
  .cta-licencias {
    background: var(--color-primario);
    color: white;
    padding: 4rem 0;
    text-align: center;
  }

  .cta-licencias h2 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    margin-bottom: 0.75rem;
  }

  .cta-licencias p {
    margin-bottom: 2rem;
    font-size: 1.05rem;
    opacity: 0.92;
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn-cta-white,
  .btn-cta-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 1.5rem;
    border-radius: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s;
    min-width: 140px;
  }

  .btn-cta-white {
    background: white;
    color: var(--color-primario);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .btn-cta-white:hover {
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
  }

  .btn-cta-outline {
    border: 2px solid white;
    color: white;
  }

  .btn-cta-outline:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 1023px) {
    .container {
      padding: 0 1.25rem;
    }

    /* Tablet: CTA en fila propia para no desbordar */
    .asistente-feature-cta {
      flex: 1 1 100%;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }
  }

  @media (max-width: 768px) {
    .hero-simple {
      padding: 2.75rem 0 4.5rem;
    }

    .hero-simple p {
      font-size: 1rem;
    }

    .asistente-float {
      margin-top: -3.25rem;
    }

    .asistente-feature {
      padding: 1.15rem 1.25rem;
      border-radius: 14px;
    }

    .asistente-feature-body {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }

    .asistente-feature-icon {
      width: 48px;
      height: 48px;
    }

    .asistente-feature-icon svg {
      width: 26px;
      height: 26px;
    }

    .asistente-feature-cta {
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
      padding: 0.85rem 1.25rem;
    }

    .licencia-contacto {
      padding: 1.5rem 0 2rem;
    }

    .cta-licencias {
      padding: 3rem 0;
    }
  }

  @media (max-width: 599px) {
    .container {
      padding: 0 1rem;
    }

    .hero-simple {
      padding: 2.25rem 0 4rem;
    }

    .asistente-feature h2 {
      font-size: 1.2rem;
    }

    .asistente-feature p {
      font-size: 0.9rem;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }

    .btn-cta-white,
    .btn-cta-outline {
      width: 100%;
      max-width: 280px;
    }
  }
</style>
