---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Asistente Licencia de Conducir (Staging) — San Vicente">
  <main class="asistente-page">
    <section class="hero-asistente">
      <div class="container">
        <a href="/Tramites/licencia" class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          Volver a Licencias
        </a>
        <span class="staging-badge">Versión de prueba</span>
        <h1>Asistente de Licencia de Conducir</h1>
        <p>Respondé unas preguntas y te indicamos los requisitos, costo y turno según tu trámite.</p>
      </div>
    </section>

    <section class="iframe-section">
      <div class="container">
        <div class="iframe-wrap" id="chatbot-iframe-wrap">
          <iframe
            id="chatbot-iframe"
            src="/chatbot/licencia/index.html"
            title="Asistente de Licencia de Conducir"
            loading="lazy"
            allow="clipboard-write"
          ></iframe>
        </div>
        <p class="disclaimer">
          Esta es una versión de prueba. Los datos no se guardan en un servidor —
          el resumen se genera localmente en tu dispositivo.
        </p>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      const wrap = document.getElementById("chatbot-iframe-wrap");
      if (!wrap) return;
      const iframe = document.getElementById("chatbot-iframe");
      window.addEventListener("message", (e) => {
        if (!iframe || e.source !== iframe.contentWindow) return;
        const data = e.data || {};
        if (data.type !== "sv-chatbot-modal") return;
        if (data.open) {
          wrap.classList.add("is-fullscreen");
          document.documentElement.style.overflow = "hidden";
        } else {
          wrap.classList.remove("is-fullscreen");
          document.documentElement.style.overflow = "";
        }
      });
    })();
  </script>
</Layout>

<style>
  .asistente-page {
    background-color: var(--color-fondo-claro);
    color: var(--color-texto);
    min-height: 70vh;
  }
  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .hero-asistente {
    background: var(--color-primario);
    color: white;
    padding: 2.5rem 0 2rem;
  }
  .hero-asistente .container {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .back-link {
    color: white;
    opacity: 0.85;
    text-decoration: none;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    width: fit-content;
    transition: opacity 0.15s;
  }
  .back-link:hover {
    opacity: 1;
  }
  .staging-badge {
    background: rgba(255, 255, 255, 0.18);
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    width: fit-content;
  }
  .hero-asistente h1 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 800;
    margin: 0;
  }
  .hero-asistente p {
    font-size: 1rem;
    opacity: 0.92;
    max-width: 640px;
    margin: 0;
  }

  .iframe-section {
    padding: 2rem 0 4rem;
  }
  .iframe-wrap {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
    overflow: hidden;
    max-width: 720px;
    margin: 0 auto;
    transition: max-width 0.18s ease, border-radius 0.18s ease;
  }
  .iframe-wrap iframe {
    display: block;
    width: 100%;
    height: 78vh;
    min-height: 600px;
    border: 0;
    background: white;
    transition: height 0.18s ease;
  }
  /* Fullscreen: iframe takes over viewport so its position:fixed modal (resumen / turno) covers the whole site. */
  .iframe-wrap.is-fullscreen {
    position: fixed;
    inset: 0;
    max-width: 100%;
    margin: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    z-index: 1000;
  }
  .iframe-wrap.is-fullscreen iframe {
    height: 100vh;
    min-height: 100vh;
  }
  .disclaimer {
    margin: 1.25rem auto 0;
    max-width: 720px;
    font-size: 0.8rem;
    color: #64748b;
    text-align: center;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .hero-asistente {
      padding: 2rem 0 1.5rem;
    }
    .iframe-section {
      padding: 1.25rem 0 2.5rem;
    }
    .iframe-wrap iframe {
      height: 82vh;
      min-height: 520px;
    }
  }
</style>
